{
  "name": "sierge",
  "version": "0.1.0",
  "private": true,
  "description": "Sierge — a local management workspace that lets a non-technical owner direct Claude Code safely.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run typecheck",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/server/index.ts",
    "selftest": "tsx src/server/policy/selftest-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.217",
    "@fastify/static": "10.1.0",
    "execa": "10.0.0",
    "fastify": "5.10.0",
    "get-port": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tree-kill": "1.2.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
